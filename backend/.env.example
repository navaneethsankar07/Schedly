# Django Environment Setup!
# To actually make Google Auth work safely & securely without exposing it, use this file.
# 1. Create your Google OAuth 2 Client in Google Cloud Console
# 2. Put your ID here
GOOGLE_OAUTH_CLIENT_ID=your-actual-client-id-here.apps.googleusercontent.com

# ── Gmail SMTP Email Setup ────────────────────────────────────────────────────
# To enable real email delivery (24h reminders + due notifications):
# 1. Go to https://myaccount.google.com/security → 2-Step Verification → App Passwords
# 2. Create an App Password for "Mail" / "Other (Custom name)"  → copy the 16-char password
# 3. Fill in below:
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# ─────────────────────────────────────────────────────────────────────────────
# If EMAIL_HOST_USER is left blank, emails will print to the console (dev mode).
